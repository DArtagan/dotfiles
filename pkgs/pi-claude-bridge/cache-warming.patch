--- /dev/null
+++ b/tests/unit-cache-warming.mjs
@@ -0,0 +1,285 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import {
+	CacheWarmer,
+	ONE_HOUR_MS,
+	refreshDelayMs,
+	refreshHeld,
+	resolveCacheWarmingSettings,
+	ttlFromUsage,
+} from "../src/cache-warming.ts";
+import activate, { __test } from "../src/index.js";
+
+const MIN = 60_000;
+const wrote1h = (tokens) => ({ input_tokens: 2, cache_read_input_tokens: tokens - 1002, cache_creation_input_tokens: 1000, cache_creation: { ephemeral_1h_input_tokens: 1000, ephemeral_5m_input_tokens: 0 } });
+const readBack = (tokens) => ({ input_tokens: 2, cache_read_input_tokens: tokens, cache_creation_input_tokens: 200, cache_creation: { ephemeral_1h_input_tokens: 200, ephemeral_5m_input_tokens: 0 } });
+
+/** A clock and timer queue the test advances by hand. */
+function fakeTime() {
+	let now = 0;
+	let timers = [];
+	return {
+		now: () => now,
+		setTimer: (fn, ms) => { const t = { at: now + ms, fn }; timers.push(t); return t; },
+		clearTimer: (t) => { timers = timers.filter((x) => x !== t); },
+		pending: () => timers.length,
+		nextAt: () => Math.min(...timers.map((t) => t.at)),
+		/** Run the earliest timer, moving the clock to it, and let its refresh settle. */
+		async fireNext(extraDelay = 0) {
+			timers.sort((a, b) => a.at - b.at);
+			const t = timers.shift();
+			now = t.at + extraDelay;
+			t.fn();
+			for (let i = 0; i < 5; i++) await Promise.resolve();
+		},
+		advance: (ms) => { now += ms; },
+	};
+}
+
+function makeWarmer({ settings = { enabled: true, idleWindowMinutes: 720, minPromptTokens: 20_000 }, current = () => true, refresh } = {}) {
+	const time = fakeTime();
+	const logs = [];
+	const refreshes = [];
+	const warmer = new CacheWarmer(() => settings, {
+		now: time.now,
+		setTimer: time.setTimer,
+		clearTimer: time.clearTimer,
+		isCurrent: (key, recipe) => current(key, recipe),
+		refresh: refresh ?? (async (recipe) => { refreshes.push({ recipe, at: time.now() }); return { at: time.now(), usage: readBack(100_000) }; }),
+		log: (m) => logs.push(m),
+	});
+	return { warmer, time, logs, refreshes };
+}
+
+const turn = (usage = wrote1h(100_000), at = 0) => ({ recipe: { id: "r" }, prefill: { at, usage }, ttlMs: ttlFromUsage(usage) });
+
+describe("cache warming decisions", () => {
+	it("reads the entry lifetime from the tier a request wrote", () => {
+		assert.equal(ttlFromUsage(wrote1h(50_000)), ONE_HOUR_MS);
+		assert.equal(ttlFromUsage({ cache_creation: { ephemeral_5m_input_tokens: 10 } }), 5 * MIN);
+		assert.equal(ttlFromUsage({ cache_read_input_tokens: 10 }), undefined);
+	});
+
+	it("refreshes a one-hour entry at 54 minutes", () => {
+		assert.equal(refreshDelayMs(ONE_HOUR_MS), 54 * MIN);
+	});
+
+	it("counts a refresh as held only when it read the prefix back", () => {
+		assert.equal(refreshHeld(readBack(100_000)), true);
+		assert.equal(refreshHeld({ cache_read_input_tokens: 0, cache_creation_input_tokens: 100_000 }), false);
+		assert.equal(refreshHeld({ cache_read_input_tokens: 6_000, cache_creation_input_tokens: 94_000 }), false);
+	});
+
+	it("is off unless enabled, and ignores nonsense numbers", () => {
+		assert.deepEqual(resolveCacheWarmingSettings(undefined), { enabled: false, idleWindowMinutes: 120, minPromptTokens: 20_000 });
+		assert.deepEqual(resolveCacheWarmingSettings({ enabled: true, idleWindowMinutes: -5, minPromptTokens: "x" }), { enabled: true, idleWindowMinutes: 120, minPromptTokens: 20_000 });
+	});
+});
+
+describe("CacheWarmer", () => {
+	it("keeps a settled session warm for the window, then stops", async () => {
+		const { warmer, time, refreshes, logs } = makeWarmer();
+		warmer.noteTurn("s1", turn());
+		warmer.arm("s1");
+		assert.equal(time.nextAt(), 54 * MIN);
+		while (time.pending()) await time.fireNext();
+		// Refreshed at 54, 108, …, 702 minutes; the last one's entry lives past 720.
+		assert.deepEqual(refreshes.map((r) => r.at / MIN), Array.from({ length: 13 }, (_, i) => 54 * (i + 1)));
+		assert.equal(warmer.isWarming("s1"), false);
+		assert.match(logs.at(-1), /stopped after 13 refreshes, window covered/);
+	});
+
+	it("does not arm without a candidate turn, when disabled, for a 5-minute entry, or for a small context", () => {
+		const cases = [
+			{ settings: { enabled: false, idleWindowMinutes: 720, minPromptTokens: 0 }, candidate: turn() },
+			{ settings: { enabled: true, idleWindowMinutes: 720, minPromptTokens: 0 }, candidate: { ...turn(), ttlMs: 5 * MIN } },
+			{ settings: { enabled: true, idleWindowMinutes: 720, minPromptTokens: 0 }, candidate: { ...turn(), ttlMs: undefined } },
+			{ settings: { enabled: true, idleWindowMinutes: 720, minPromptTokens: 200_000 }, candidate: turn() },
+			{ settings: { enabled: true, idleWindowMinutes: 720, minPromptTokens: 0 }, candidate: null },
+		];
+		for (const { settings, candidate } of cases) {
+			const { warmer, time } = makeWarmer({ settings });
+			if (candidate) warmer.noteTurn("s1", candidate);
+			warmer.arm("s1");
+			assert.equal(time.pending(), 0, JSON.stringify({ settings, candidate }));
+		}
+	});
+
+	it("uses a noted turn once: a second settle without a new turn arms nothing", () => {
+		const { warmer, time } = makeWarmer();
+		warmer.noteTurn("s1", turn());
+		warmer.arm("s1");
+		warmer.forget("s1", "run started");
+		warmer.arm("s1");
+		assert.equal(time.pending(), 0);
+	});
+
+	it("stops when the session moved on before the refresh", async () => {
+		let current = true;
+		const { warmer, time, refreshes, logs } = makeWarmer({ current: () => current });
+		warmer.noteTurn("s1", turn());
+		warmer.arm("s1");
+		current = false;
+		await time.fireNext();
+		assert.equal(refreshes.length, 0);
+		assert.match(logs.at(-1), /session moved on/);
+	});
+
+	it("gives up on a timer that fires too close to expiry, e.g. after a suspend", async () => {
+		const { warmer, time, refreshes, logs } = makeWarmer();
+		warmer.noteTurn("s1", turn());
+		warmer.arm("s1");
+		await time.fireNext(5.5 * MIN); // 59.5 minutes after the turn's prefill
+		assert.equal(refreshes.length, 0);
+		assert.match(logs.at(-1), /too late/);
+	});
+
+	it("stops after a refresh that found the cache cold", async () => {
+		const { warmer, time, logs } = makeWarmer({
+			refresh: async () => ({ at: time.now(), usage: { cache_read_input_tokens: 6_000, cache_creation_input_tokens: 94_000 } }),
+		});
+		warmer.noteTurn("s1", turn());
+		warmer.arm("s1");
+		await time.fireNext();
+		assert.equal(time.pending(), 0);
+		assert.match(logs.at(-1), /cache cold, read=6000 wrote=94000/);
+	});
+
+	it("stops after a failed refresh", async () => {
+		const { warmer, time, logs } = makeWarmer({ refresh: async () => { throw new Error("rate limited"); } });
+		warmer.noteTurn("s1", turn());
+		warmer.arm("s1");
+		await time.fireNext();
+		assert.equal(time.pending(), 0);
+		assert.match(logs.at(-1), /refresh failed: rate limited/);
+	});
+
+	it("aborts a refresh in flight when a new run starts, and does not reschedule", async () => {
+		let signal;
+		let resolve;
+		const { warmer, time } = makeWarmer({ refresh: (_recipe, s) => { signal = s; return new Promise((r) => { resolve = r; }); } });
+		warmer.noteTurn("s1", turn());
+		warmer.arm("s1");
+		await time.fireNext();
+		assert.equal(signal.aborted, false);
+		warmer.forget("s1", "run started");
+		assert.equal(signal.aborted, true);
+		resolve({ at: time.now(), usage: readBack(100_000) });
+		for (let i = 0; i < 5; i++) await Promise.resolve();
+		assert.equal(time.pending(), 0);
+	});
+
+	it("keeps sessions apart", async () => {
+		const { warmer, time } = makeWarmer();
+		warmer.noteTurn("s1", turn());
+		warmer.noteTurn("s2", turn());
+		warmer.arm("s1");
+		warmer.arm("s2");
+		warmer.forget("s1", "run started");
+		assert.equal(warmer.isWarming("s1"), false);
+		assert.equal(warmer.isWarming("s2"), true);
+		warmer.stopAll("session_shutdown");
+		assert.equal(time.pending(), 0);
+	});
+});
+
+describe("cache warming through the provider", () => {
+	// Activation reads the user's config, so the settings are set after it. Clearing the
+	// registration marker makes each test's instance the first, which registers.
+	function activateBridge() {
+		globalThis[Symbol.for("claude-bridge:activeStreamSimple")] = undefined;
+		const handlers = {};
+		let providerConfig;
+		activate({
+			on: (name, fn) => { (handlers[name] ??= []).push(fn); },
+			registerProvider: (_name, config) => { providerConfig = config; },
+			registerTool: () => {},
+		});
+		__test.setCacheWarmingSettings({ enabled: true, idleWindowMinutes: 720, minPromptTokens: 20_000 });
+		const ctx = (sessionId, hasUI = true) => ({ cwd: process.cwd(), hasUI, mode: "tui", sessionManager: { getSessionId: () => sessionId }, getSystemPrompt: () => undefined, ui: {} });
+		const emit = (name, event, c) => { for (const fn of handlers[name] ?? []) fn(event, c); };
+		return { providerConfig, ctx, emit };
+	}
+
+	/** A query double: records each call, and replays a turn that wrote 100k tokens to
+	 *  the one-hour cache, or for a refresh one that reads them back. */
+	function fakeQuery(calls) {
+		return ({ prompt, options }) => {
+			const call = { prompt, options, interrupted: false, closed: false };
+			calls.push(call);
+			const refresh = Boolean(options.forkSession);
+			const gen = (async function* () {
+				yield { type: "system", subtype: "init", session_id: refresh ? "cc-fork" : "cc-main" };
+				yield { type: "stream_event", event: { type: "message_start", message: { id: "m1", usage: refresh ? readBack(100_000) : wrote1h(100_000) } } };
+				if (refresh) throw new Error("refresh read past message_start");
+				yield { type: "stream_event", event: { type: "message_delta", delta: { stop_reason: "end_turn" }, usage: { output_tokens: 3 } } };
+				yield { type: "result", subtype: "success", is_error: false, result: "ok" };
+			})();
+			gen.interrupt = async () => { call.interrupted = true; };
+			gen.close = () => { call.closed = true; };
+			return gen;
+		};
+	}
+
+	it("refreshes a settled session's cache with the turn's own options, forked and unpersisted", async (t) => {
+		t.mock.timers.enable({ apis: ["setTimeout", "Date"] });
+		const calls = [];
+		__test.setQuery(fakeQuery(calls));
+		t.after(() => {
+			__test.setQuery(null);
+			__test.cacheWarmer.stopAll("test end");
+			__test.setCacheWarmingSettings(resolveCacheWarmingSettings(undefined));
+			__test.resetSharedSession();
+		});
+		const { providerConfig, ctx, emit } = activateBridge();
+		const tool = { name: "read", description: "Read a file", parameters: { type: "object", properties: { path: { type: "string" } } } };
+
+		await providerConfig.streamSimple(providerConfig.models[0], { messages: [{ role: "user", content: "hi", timestamp: 0 }], tools: [tool] }, { sessionId: "s-warm" }).result();
+		emit("agent_settled", { aborted: false }, ctx("s-warm"));
+		assert.equal(__test.cacheWarmer.isWarming("s-warm"), true);
+		assert.equal(calls.length, 1);
+
+		t.mock.timers.tick(54 * MIN);
+		for (let i = 0; i < 20 && calls.length < 2; i++) await new Promise((r) => setImmediate(r));
+		assert.equal(calls.length, 2);
+		const [turnCall, refreshCall] = calls;
+		assert.equal(refreshCall.options.resume, "cc-main");
+		assert.equal(refreshCall.options.forkSession, true);
+		assert.equal(refreshCall.options.persistSession, false);
+		for (const key of ["cwd", "tools", "systemPrompt", "settings", "extraArgs", "effort", "includePartialMessages", "permissionMode"]) {
+			assert.deepEqual(refreshCall.options[key], turnCall.options[key], key);
+		}
+		assert.deepEqual(Object.keys(refreshCall.options.mcpServers), Object.keys(turnCall.options.mcpServers));
+		// Cut off at prefill: nothing past message_start is read.
+		for (let i = 0; i < 20 && !refreshCall.closed; i++) await new Promise((r) => setImmediate(r));
+		assert.equal(refreshCall.closed, true);
+		// The refresh held, so the next one is due 54 minutes after it.
+		assert.equal(__test.cacheWarmer.isWarming("s-warm"), true);
+	});
+
+	it("does not warm a headless session, and stops at its next query", async (t) => {
+		const calls = [];
+		__test.setQuery(fakeQuery(calls));
+		t.after(() => {
+			__test.setQuery(null);
+			__test.cacheWarmer.stopAll("test end");
+			__test.setCacheWarmingSettings(resolveCacheWarmingSettings(undefined));
+			__test.resetSharedSession();
+		});
+		const { providerConfig, ctx, emit } = activateBridge();
+		const run = async (id) => {
+			await providerConfig.streamSimple(providerConfig.models[0], { messages: [{ role: "user", content: "hi", timestamp: 0 }], tools: [] }, { sessionId: id }).result();
+		};
+
+		await run("s-child");
+		emit("agent_settled", { aborted: false }, ctx("s-child", false));
+		assert.equal(__test.cacheWarmer.isWarming("s-child"), false);
+
+		await run("s-top");
+		emit("agent_settled", { aborted: false }, ctx("s-top"));
+		assert.equal(__test.cacheWarmer.isWarming("s-top"), true);
+		const next = providerConfig.streamSimple(providerConfig.models[0], { messages: [{ role: "user", content: "hi", timestamp: 0 }, { role: "assistant", content: [{ type: "text", text: "ok" }], timestamp: 1 }, { role: "user", content: "again", timestamp: 2 }], tools: [] }, { sessionId: "s-top" });
+		assert.equal(__test.cacheWarmer.isWarming("s-top"), false);
+		await next.result();
+	});
+});
