@@ -0,0 +1,244 @@
+// Keeps an idle pi session's prompt cache alive between turns.
+//
+// Claude Code writes the conversation prefix to Anthropic's prompt cache, which
+// serves it at a fraction of the input price for as long as the entry lives: one
+// hour on subscription auth, five minutes on API keys. Every read refreshes the
+// entry. Coming back to a session after the entry expired re-writes the whole
+// conversation at the 1-hour write price — on Opus 5.5 about 40x a read.
+//
+// While a session sits idle, the bridge re-sends its last request shortly before
+// the entry expires: Claude Code resumes the session with the provider query's own
+// options, forked and unpersisted so the session file pi depends on is untouched,
+// and the request is cut off once prefill (where the cache is read and refreshed)
+// is done. That read costs 1/40 of the re-write it prevents, so warming pays off
+// whenever the session is resumed within the window at least once in 40 refreshes.
+//
+// This module is the schedule and the decisions; index.ts supplies the query.
+
+export interface CacheWarmingSettings {
+	enabled: boolean;
+	/** How long after the last turn a session is kept warm. */
+	idleWindowMinutes: number;
+	/** Contexts smaller than this are not worth a Claude Code process per refresh. */
+	minPromptTokens: number;
+}
+
+export const DEFAULT_CACHE_WARMING: CacheWarmingSettings = {
+	enabled: false,
+	idleWindowMinutes: 120,
+	minPromptTokens: 20_000,
+};
+
+export function resolveCacheWarmingSettings(conf: Partial<CacheWarmingSettings> | undefined): CacheWarmingSettings {
+	const pick = (value: unknown, fallback: number) =>
+		typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : fallback;
+	return {
+		enabled: conf?.enabled ?? DEFAULT_CACHE_WARMING.enabled,
+		idleWindowMinutes: pick(conf?.idleWindowMinutes, DEFAULT_CACHE_WARMING.idleWindowMinutes),
+		minPromptTokens: pick(conf?.minPromptTokens, DEFAULT_CACHE_WARMING.minPromptTokens),
+	};
+}
+
+/** Usage as reported on an Anthropic `message_start`, the moment prefill is done. */
+export interface PrefillUsage {
+	input_tokens?: number | null;
+	cache_read_input_tokens?: number | null;
+	cache_creation_input_tokens?: number | null;
+	cache_creation?: {
+		ephemeral_5m_input_tokens?: number | null;
+		ephemeral_1h_input_tokens?: number | null;
+	} | null;
+}
+
+export interface Prefill {
+	/** When message_start arrived. The entry's lifetime runs from here, not from the
+	 *  end of the response: Anthropic reads and refreshes the cache during prefill. */
+	at: number;
+	usage: PrefillUsage;
+}
+
+export const ONE_HOUR_MS = 60 * 60_000;
+
+/** The lifetime of the entries a request wrote: one hour or five minutes, or
+ *  undefined when it wrote none, which says nothing about the tier. */
+export function ttlFromUsage(usage: PrefillUsage): number | undefined {
+	if ((usage.cache_creation?.ephemeral_1h_input_tokens ?? 0) > 0) return ONE_HOUR_MS;
+	if ((usage.cache_creation?.ephemeral_5m_input_tokens ?? 0) > 0) return 5 * 60_000;
+	return undefined;
+}
+
+export function promptTokens(usage: PrefillUsage): number {
+	return (usage.input_tokens ?? 0) + (usage.cache_read_input_tokens ?? 0) + (usage.cache_creation_input_tokens ?? 0);
+}
+
+/** Refresh at 90% of the lifetime, keeping at least ten seconds in hand (pi's own
+ *  cache warmer uses the same margin): 54 minutes for a one-hour entry. */
+export function refreshDelayMs(ttlMs: number): number {
+	return Math.max(1, Math.floor(Math.min(ttlMs * 0.9, ttlMs - 10_000)));
+}
+
+/** A timer that fires this close to expiry, or later, came back from a suspend or a
+ *  blocked event loop. The entry may already be gone, and a refresh of a gone entry
+ *  is a full-price write, so give up rather than guess. */
+const LATE_MARGIN_MS = 60_000;
+
+/** A refresh that read nothing, or wrote more than a tenth of what it read, did not
+ *  find the prefix — it expired, or the request no longer matches. Either way more
+ *  refreshes would be full-price writes. */
+export function refreshHeld(usage: PrefillUsage): boolean {
+	const read = usage.cache_read_input_tokens ?? 0;
+	const written = usage.cache_creation_input_tokens ?? 0;
+	return read > 0 && written <= read * 0.1;
+}
+
+/** One session's warming, armed when its run settles and gone once it stops. */
+interface Warming<R> {
+	recipe: R;
+	ttlMs: number;
+	tokens: number;
+	/** Last read or write of the entry: the end of the turn, then each refresh. */
+	lastPrefillAt: number;
+	windowEndsAt: number;
+	refreshes: number;
+	timer?: unknown;
+	inFlight?: AbortController;
+}
+
+export interface CacheWarmerDeps<R> {
+	now(): number;
+	setTimer(fn: () => void, ms: number): unknown;
+	clearTimer(handle: unknown): void;
+	/** Whether the session still ends where `recipe` was taken: no turn since, no
+	 *  pending rebuild. Checked before each refresh. */
+	isCurrent(key: string, recipe: R): boolean;
+	/** Send the refresh and resolve with its prefill, or undefined if it never got
+	 *  that far. Must stop the request at prefill and honour `signal`. */
+	refresh(recipe: R, signal: AbortSignal): Promise<Prefill | undefined>;
+	log(message: string): void;
+}
+
+export interface CandidateTurn<R> {
+	recipe: R;
+	prefill: Prefill;
+	/** Lifetime of the entries the turn wrote, if any request in it wrote one. */
+	ttlMs: number | undefined;
+}
+
+export class CacheWarmer<R> {
+	private readonly candidates = new Map<string, CandidateTurn<R>>();
+	private readonly warmings = new Map<string, Warming<R>>();
+
+	constructor(private readonly settings: () => CacheWarmingSettings, private readonly deps: CacheWarmerDeps<R>) {}
+
+	/** A provider query for `key` finished cleanly; its prefix is what to keep warm
+	 *  if the run settles here. */
+	noteTurn(key: string, turn: CandidateTurn<R>): void {
+		this.candidates.set(key, turn);
+	}
+
+	/** The run in `key` settled with nothing more to do: start keeping its last
+	 *  turn's prefix warm. */
+	arm(key: string): void {
+		this.stop(key, null);
+		const candidate = this.candidates.get(key);
+		this.candidates.delete(key);
+		const settings = this.settings();
+		if (!candidate || !settings.enabled || settings.idleWindowMinutes <= 0) return;
+		const tokens = promptTokens(candidate.prefill.usage);
+		if (candidate.ttlMs !== ONE_HOUR_MS) {
+			// A five-minute entry would need a refresh every 4.5 minutes, each a
+			// twelfth of a re-write: an hour of that costs more than the miss.
+			this.deps.log(`cache warming: ${key.slice(0, 8)} not armed, ttl=${candidate.ttlMs ?? "unknown"}`);
+			return;
+		}
+		if (tokens < settings.minPromptTokens) {
+			this.deps.log(`cache warming: ${key.slice(0, 8)} not armed, ${tokens} tokens < ${settings.minPromptTokens}`);
+			return;
+		}
+		const warming: Warming<R> = {
+			recipe: candidate.recipe,
+			ttlMs: candidate.ttlMs,
+			tokens,
+			lastPrefillAt: candidate.prefill.at,
+			windowEndsAt: this.deps.now() + settings.idleWindowMinutes * 60_000,
+			refreshes: 0,
+		};
+		this.warmings.set(key, warming);
+		this.deps.log(`cache warming: ${key.slice(0, 8)} armed, ${tokens} tokens, window ${settings.idleWindowMinutes}m`);
+		this.schedule(key, warming);
+	}
+
+	/** Stop warming `key`, aborting a refresh in flight. `reason` null is silent. */
+	stop(key: string, reason: string | null): void {
+		const warming = this.warmings.get(key);
+		if (!warming) return;
+		this.warmings.delete(key);
+		if (warming.timer !== undefined) this.deps.clearTimer(warming.timer);
+		warming.inFlight?.abort();
+		if (reason) this.deps.log(`cache warming: ${key.slice(0, 8)} stopped after ${warming.refreshes} refreshes, ${reason}`);
+	}
+
+	/** A new run started in `key`: whatever was armed or noted is about to be superseded. */
+	forget(key: string, reason: string): void {
+		this.candidates.delete(key);
+		this.stop(key, reason);
+	}
+
+	stopAll(reason: string): void {
+		this.candidates.clear();
+		for (const key of [...this.warmings.keys()]) this.stop(key, reason);
+	}
+
+	isWarming(key: string): boolean {
+		return this.warmings.has(key);
+	}
+
+	private schedule(key: string, warming: Warming<R>): void {
+		// The entry outlives the window already: nothing left to keep warm.
+		if (warming.lastPrefillAt + warming.ttlMs >= warming.windowEndsAt) {
+			this.stop(key, "window covered");
+			return;
+		}
+		const at = warming.lastPrefillAt + refreshDelayMs(warming.ttlMs);
+		warming.timer = this.deps.setTimer(() => void this.fire(key, warming), Math.max(0, at - this.deps.now()));
+	}
+
+	private async fire(key: string, warming: Warming<R>): Promise<void> {
+		warming.timer = undefined;
+		if (this.warmings.get(key) !== warming) return;
+		if (this.deps.now() > warming.lastPrefillAt + warming.ttlMs - LATE_MARGIN_MS) {
+			this.stop(key, "refresh came too late, entry may have expired");
+			return;
+		}
+		if (!this.deps.isCurrent(key, warming.recipe)) {
+			this.stop(key, "session moved on");
+			return;
+		}
+		const controller = new AbortController();
+		warming.inFlight = controller;
+		let prefill: Prefill | undefined;
+		try {
+			prefill = await this.deps.refresh(warming.recipe, controller.signal);
+		} catch (error) {
+			if (this.warmings.get(key) === warming) this.stop(key, `refresh failed: ${error instanceof Error ? error.message : String(error)}`);
+			return;
+		} finally {
+			warming.inFlight = undefined;
+		}
+		// Stopped while the refresh ran: a new turn, or the session went away.
+		if (this.warmings.get(key) !== warming) return;
+		if (!prefill) {
+			this.stop(key, "refresh ended before prefill");
+			return;
+		}
+		const u = prefill.usage;
+		if (!refreshHeld(u)) {
+			this.stop(key, `cache cold, read=${u.cache_read_input_tokens ?? 0} wrote=${u.cache_creation_input_tokens ?? 0}`);
+			return;
+		}
+		warming.refreshes++;
+		warming.lastPrefillAt = prefill.at;
+		this.deps.log(`cache warming: ${key.slice(0, 8)} refresh ${warming.refreshes}, read=${u.cache_read_input_tokens ?? 0} wrote=${u.cache_creation_input_tokens ?? 0}`);
+		this.schedule(key, warming);
+	}
+}
