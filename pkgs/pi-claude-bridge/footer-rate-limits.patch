diff --git a/tests/unit-rate-limit-status.mjs b/tests/unit-rate-limit-status.mjs
new file mode 100644
index 0000000..65def25
--- /dev/null
+++ b/tests/unit-rate-limit-status.mjs
@@ -0,0 +1,91 @@
+/**
+ * Plan utilization in pi's footer. Claude Code sends a rate_limit_event with every
+ * request; its `unifiedWindows` (not in the SDK's types) carries each plan window's
+ * utilization, which the bridge renders through ctx.ui.setStatus.
+ */
+import { describe, it, beforeEach } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { QueryContext } from "../src/query-state.js";
+
+const { __test } = await import("../src/index.js");
+
+const model = {
+	api: "anthropic-messages", provider: "anthropic", id: "claude-haiku-4-5",
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+};
+
+function fakeUI() {
+	const statuses = new Map();
+	return { statuses, setStatus: (key, text) => statuses.set(key, text), notify: () => {} };
+}
+
+async function consume(messages) {
+	const c = new QueryContext();
+	c.currentPiStream = { push: () => {}, end: () => {} };
+	c.resetTurnState(model);
+	async function* gen() { for (const m of messages) yield m; }
+	await __test.consumeQuery(gen(), new Map(), model, () => false, c);
+}
+
+function fixture(name) {
+	const path = new URL(`./fixtures/sdk-streams/${name}.jsonl`, import.meta.url);
+	return readFileSync(path, "utf8").split("\n").filter(Boolean).map((l) => JSON.parse(l));
+}
+
+const event = (rate_limit_info) => ({ type: "rate_limit_event", rate_limit_info });
+
+describe("formatRateLimitStatus", () => {
+	it("renders every unified window as a percentage", () => {
+		const text = __test.formatRateLimitStatus({
+			status: "allowed", rateLimitType: "five_hour",
+			unifiedWindows: {
+				five_hour: { utilization: 0.19, resetsAt: 1790800800 },
+				seven_day: { utilization: 0.12, resetsAt: 1791187200 },
+			},
+		});
+		assert.match(text, /^Claude 5h 19% ↻[^·]+ · 7d 12% ↻[^·]+$/);
+	});
+
+	it("falls back to the typed utilization when unifiedWindows is absent", () => {
+		const text = __test.formatRateLimitStatus({ status: "allowed_warning", rateLimitType: "seven_day", utilization: 0.8 });
+		assert.match(text, /^Claude 7d 80%$/);
+	});
+
+	it("keeps an unknown window under its own name", () => {
+		const text = __test.formatRateLimitStatus({ unifiedWindows: { new_window: { utilization: 0.5 } } });
+		assert.strictEqual(text, "Claude new_window 50%");
+	});
+
+	it("flags a rejected window", () => {
+		const text = __test.formatRateLimitStatus({ status: "rejected", unifiedWindows: { five_hour: { utilization: 1 } } });
+		assert.strictEqual(text, "Claude (limited) 5h 100%");
+	});
+
+	it("returns undefined when there is no utilization to show", () => {
+		assert.strictEqual(__test.formatRateLimitStatus({ status: "allowed", rateLimitType: "five_hour" }), undefined);
+		assert.strictEqual(__test.formatRateLimitStatus(undefined), undefined);
+	});
+});
+
+describe("rate_limit_event footer status", () => {
+	let ui;
+	beforeEach(() => {
+		ui = fakeUI();
+		__test.setPiUI(ui);
+		__test.resetRateLimitStatus();
+	});
+
+	it("shows the latest utilization from a recorded turn", async () => {
+		// Two requests in one turn: 14% then 15% of the five-hour window.
+		await consume(fixture("parallel-tools"));
+		assert.match(ui.statuses.get("claude-bridge-limits"), /^Claude 5h 15% ↻[^·]+ · 7d 1% ↻[^·]+$/);
+		assert.strictEqual(__test.rateLimitStatus, ui.statuses.get("claude-bridge-limits"));
+	});
+
+	it("keeps the last status when an event carries no utilization", async () => {
+		await consume([event({ status: "allowed", unifiedWindows: { five_hour: { utilization: 0.3 } } })]);
+		await consume([event({ status: "allowed", rateLimitType: "five_hour" })]);
+		assert.strictEqual(ui.statuses.get("claude-bridge-limits"), "Claude 5h 30%");
+	});
+});
