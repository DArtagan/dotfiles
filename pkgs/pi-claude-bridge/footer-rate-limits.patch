+const RATE_LIMIT_STATUS_KEY = "claude-bridge-limits";
+const RATE_LIMIT_WINDOW_LABELS: Record<string, string> = {
+	five_hour: "5h",
+	seven_day: "7d",
+	seven_day_opus: "7d Opus",
+	seven_day_sonnet: "7d Sonnet",
+};
+
+/** Footer text for a rate_limit_event, e.g. "Claude 5h 19% ↻14:00 · 7d 12% ↻Fri".
+ *
+ *  `unifiedWindows` is absent from the SDK's SDKRateLimitInfo type, but Claude Code sends
+ *  it on every request's event with each plan window's utilization — the same data its
+ *  own statusline gets. The typed `utilization` covers only the binding window, and only
+ *  near a threshold, so it is the fallback. Utilization is a fraction (0..1); resetsAt is
+ *  Unix seconds. Returns undefined when the event carries no utilization at all. */
+function formatRateLimitStatus(info: any): string | undefined {
+	const windows: [string, { utilization?: number; resetsAt?: number }][] =
+		info?.unifiedWindows && typeof info.unifiedWindows === "object"
+			? Object.entries(info.unifiedWindows)
+			: info?.rateLimitType && typeof info.utilization === "number"
+				? [[info.rateLimitType, { utilization: info.utilization, resetsAt: info.resetsAt }]]
+				: [];
+	const parts = windows
+		.filter(([, w]) => typeof w?.utilization === "number")
+		.map(([key, w]) => {
+			const label = RATE_LIMIT_WINDOW_LABELS[key] ?? key;
+			const percent = `${Math.round(w.utilization! * 100)}%`;
+			if (!w.resetsAt) return `${label} ${percent}`;
+			const resetsAt = new Date(w.resetsAt * 1000);
+			// Short windows reset within the day; longer ones are named by weekday.
+			const resets = key === "five_hour"
+				? resetsAt.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })
+				: resetsAt.toLocaleDateString([], { weekday: "short" });
+			return `${label} ${percent} ↻${resets}`;
+		});
+	if (parts.length === 0) return undefined;
+	const status = info?.status === "rejected" ? " (limited)" : "";
+	return `Claude${status} ${parts.join(" · ")}`;
+}
