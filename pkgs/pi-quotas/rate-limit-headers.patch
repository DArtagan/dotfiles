diff --git a/src/lib/rate-limit-headers.test.ts b/src/lib/rate-limit-headers.test.ts
new file mode 100644
index 0000000..becd9ef
--- /dev/null
+++ b/src/lib/rate-limit-headers.test.ts
@@ -0,0 +1,106 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { fetchClaudeBridgeQuotas } from "../providers/fetch.js";
+import {
+  clearRateLimitHeaders,
+  latestRateLimitWindows,
+  parseRateLimitHeaders,
+  recordRateLimitHeaders,
+} from "./rate-limit-headers.js";
+
+// As pi-claude-bridge sends them for its recorded `text` fixture.
+const HEADERS = {
+  "anthropic-ratelimit-unified-status": "allowed",
+  "anthropic-ratelimit-unified-reset": "1789770600",
+  "anthropic-ratelimit-unified-representative-claim": "five_hour",
+  "anthropic-ratelimit-unified-overage-status": "allowed",
+  "anthropic-ratelimit-unified-overage-reset": "1790812800",
+  "anthropic-ratelimit-unified-5h-utilization": "0.14",
+  "anthropic-ratelimit-unified-5h-reset": "1789770600",
+  "anthropic-ratelimit-unified-7d-utilization": "0.01",
+  "anthropic-ratelimit-unified-7d-reset": "1790042400",
+};
+const BEFORE_RESETS = 1789770600_000 - 60_000;
+
+afterEach(() => clearRateLimitHeaders());
+
+describe("parseRateLimitHeaders", () => {
+  it("turns unified windows into percentages with reset dates", () => {
+    const windows = parseRateLimitHeaders(HEADERS);
+
+    expect(windows.map((w) => w.label)).toEqual(["5h", "7d"]);
+    expect(windows[0]).toMatchObject({
+      provider: "claude-bridge",
+      usedPercent: 14,
+      windowSeconds: 5 * 60 * 60,
+      limitValue: 100,
+      limited: false,
+    });
+    expect(windows[0].resetsAt.toISOString()).toBe("2026-09-18T22:30:00.000Z");
+    expect(windows[1].usedPercent).toBe(1);
+  });
+
+  it("marks the representative window of a rejection as limited", () => {
+    const windows = parseRateLimitHeaders({
+      ...HEADERS,
+      "anthropic-ratelimit-unified-status": "rejected",
+      "anthropic-ratelimit-unified-representative-claim": "seven_day",
+    });
+
+    expect(windows.map((w) => [w.label, w.limited])).toEqual([
+      ["5h", false],
+      ["7d", true],
+    ]);
+  });
+
+  it("reads the overage-included window and ignores unknown ones", () => {
+    const windows = parseRateLimitHeaders({
+      "anthropic-ratelimit-unified-7d_oi-utilization": "0.5",
+      "anthropic-ratelimit-unified-seven_day_opus-utilization": "0.3",
+    });
+
+    expect(windows.map((w) => [w.label, w.usedPercent])).toEqual([
+      ["7d incl. overage", 50],
+    ]);
+  });
+
+  it("finds nothing in an ordinary response", () => {
+    expect(parseRateLimitHeaders({ "content-type": "text/event-stream" })).toEqual([]);
+  });
+});
+
+describe("recordRateLimitHeaders", () => {
+  it("keeps only claude-bridge responses that carry usage", () => {
+    expect(recordRateLimitHeaders("anthropic", HEADERS)).toBe(false);
+    expect(recordRateLimitHeaders("claude-bridge", {})).toBe(false);
+    expect(latestRateLimitWindows(BEFORE_RESETS)).toBeUndefined();
+
+    expect(recordRateLimitHeaders("claude-bridge", HEADERS)).toBe(true);
+    expect(latestRateLimitWindows(BEFORE_RESETS)?.map((w) => w.label)).toEqual(["5h", "7d"]);
+  });
+
+  it("drops a window once its reset has passed", () => {
+    recordRateLimitHeaders("claude-bridge", HEADERS);
+
+    expect(latestRateLimitWindows(1789770600_000 + 1)?.map((w) => w.label)).toEqual(["7d"]);
+  });
+});
+
+describe("fetchClaudeBridgeQuotas", () => {
+  it("has nothing to report before the first response", async () => {
+    const result = await fetchClaudeBridgeQuotas({} as never);
+
+    expect(result).toMatchObject({ success: false, error: { kind: "not_applicable" } });
+  });
+
+  it("reports the recorded windows", async () => {
+    recordRateLimitHeaders("claude-bridge", {
+      ...HEADERS,
+      "anthropic-ratelimit-unified-5h-reset": String(Math.floor(Date.now() / 1000) + 3600),
+      "anthropic-ratelimit-unified-7d-reset": String(Math.floor(Date.now() / 1000) + 86400),
+    });
+
+    const result = await fetchClaudeBridgeQuotas({} as never);
+
+    expect(result.success && result.data.windows.map((w) => w.label)).toEqual(["5h", "7d"]);
+  });
+});
diff --git a/src/lib/rate-limit-headers.ts b/src/lib/rate-limit-headers.ts
new file mode 100644
index 0000000..e478872
--- /dev/null
+++ b/src/lib/rate-limit-headers.ts
@@ -0,0 +1,141 @@
+import type {
+  ExtensionAPI,
+  ExtensionContext,
+} from "@mariozechner/pi-coding-agent";
+import type { QuotaWindow } from "../types/quotas.js";
+
+/**
+ * pi-claude-bridge (provider `claude-bridge`) reports the plan usage that
+ * Claude Code receives as `anthropic-ratelimit-unified-*` headers on pi's
+ * `after_provider_response` event, with the names the Anthropic API uses.
+ * Reading them needs no credentials and no request of our own.
+ */
+export const CLAUDE_BRIDGE_PROVIDER = "claude-bridge";
+
+const HEADER_PREFIX = "anthropic-ratelimit-unified";
+
+/** Header abbreviation → window label and length. Labels match parseAnthropicUsage. */
+const WINDOWS: ReadonlyArray<{
+  abbreviation: string;
+  claim: string;
+  label: string;
+  windowSeconds: number;
+}> = [
+  { abbreviation: "5h", claim: "five_hour", label: "5h", windowSeconds: 5 * 60 * 60 },
+  { abbreviation: "7d", claim: "seven_day", label: "7d", windowSeconds: 7 * 24 * 60 * 60 },
+  {
+    abbreviation: "7d_oi",
+    claim: "seven_day_overage_included",
+    label: "7d incl. overage",
+    windowSeconds: 7 * 24 * 60 * 60,
+  },
+];
+
+function headerNumber(
+  headers: Record<string, string>,
+  name: string,
+): number | undefined {
+  const raw = headers[`${HEADER_PREFIX}-${name}`];
+  if (raw === undefined || raw.trim() === "") return undefined;
+  const value = Number(raw);
+  return Number.isFinite(value) ? value : undefined;
+}
+
+/**
+ * Turn the unified rate-limit headers into quota windows. Utilization arrives
+ * as a fraction (0.14) and resets as Unix seconds. A window whose claim is the
+ * representative one of a rejected request is marked limited.
+ */
+export function parseRateLimitHeaders(
+  headers: Record<string, string>,
+): QuotaWindow[] {
+  const lower: Record<string, string> = {};
+  for (const [name, value] of Object.entries(headers)) {
+    lower[name.toLowerCase()] = value;
+  }
+  const rejected = lower[`${HEADER_PREFIX}-status`] === "rejected";
+  const claim = lower[`${HEADER_PREFIX}-representative-claim`];
+
+  const windows: QuotaWindow[] = [];
+  for (const { abbreviation, claim: windowClaim, label, windowSeconds } of WINDOWS) {
+    const utilization = headerNumber(lower, `${abbreviation}-utilization`);
+    if (utilization === undefined) continue;
+    const reset = headerNumber(lower, `${abbreviation}-reset`);
+    const usedPercent = Math.round(utilization * 10_000) / 100;
+    windows.push({
+      provider: CLAUDE_BRIDGE_PROVIDER,
+      label,
+      usedPercent,
+      resetsAt: new Date(reset === undefined ? 0 : reset * 1000),
+      windowSeconds,
+      usedValue: usedPercent,
+      limitValue: 100,
+      showPace: false,
+      nextLabel: "Resets",
+      limited: rejected && claim === windowClaim,
+    });
+  }
+  return windows;
+}
+
+type Snapshot = { windows: QuotaWindow[]; receivedAt: number };
+
+// pi loads each extension with its own module instances, so the latest
+// snapshot lives on globalThis for the footer, warnings and /quotas to share.
+const STORE_KEY = Symbol.for("pi-quotas:claude-bridge-rate-limit");
+
+function store(): { latest?: Snapshot } {
+  const global = globalThis as Record<symbol, { latest?: Snapshot } | undefined>;
+  return (global[STORE_KEY] ??= {});
+}
+
+/**
+ * Record a provider response if it came from claude-bridge and carries usage.
+ * Returns whether it did.
+ */
+export function recordRateLimitHeaders(
+  provider: string | undefined,
+  headers: Record<string, string> | undefined,
+  now = Date.now(),
+): boolean {
+  if (provider !== CLAUDE_BRIDGE_PROVIDER || !headers) return false;
+  const windows = parseRateLimitHeaders(headers);
+  if (windows.length === 0) return false;
+  store().latest = { windows, receivedAt: now };
+  return true;
+}
+
+/**
+ * The latest windows Claude Code reported, without any whose reset has passed:
+ * their usage is gone, and the new reset time is not known until the next
+ * report.
+ */
+export function latestRateLimitWindows(now = Date.now()): QuotaWindow[] | undefined {
+  const latest = store().latest;
+  if (!latest) return undefined;
+  return latest.windows.filter(
+    (window) => window.resetsAt.getTime() === 0 || window.resetsAt.getTime() > now,
+  );
+}
+
+type ProviderResponseEvent = { status: number; headers: Record<string, string> };
+
+/**
+ * Subscribe to after_provider_response, which the pi version these types come
+ * from does not declare yet. Older pis never emit it.
+ */
+export function onProviderResponse(
+  pi: ExtensionAPI,
+  handler: (event: ProviderResponseEvent, ctx: ExtensionContext) => void,
+): void {
+  (
+    pi.on as unknown as (
+      event: "after_provider_response",
+      handler: (event: ProviderResponseEvent, ctx: ExtensionContext) => void,
+    ) => void
+  )("after_provider_response", handler);
+}
+
+export function clearRateLimitHeaders(): void {
+  delete store().latest;
+}
