+/**
+ * Claude Code's plan usage for pi-claude-bridge models, from the rate-limit
+ * headers the bridge passes to after_provider_response. Nothing is fetched:
+ * until a claude-bridge response arrives, there is nothing to show.
+ */
+export async function fetchClaudeBridgeQuotas(
+  _authStorage: AuthStorage,
+  _signal?: AbortSignal,
+): Promise<QuotasResult> {
+  const windows = latestRateLimitWindows();
+  if (!windows)
+    return failure(
+      "No usage reported yet — it arrives with the next claude-bridge response",
+      "not_applicable",
+    );
+  return success("claude-bridge", windows);
+}
