   *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
   .shimmer { color: var(--muted-foreground); background: none; }
 }
+
+.diff { margin: 0; max-height: 32rem; overflow: auto; padding: .5rem 0; font: .8125rem/1.5 var(--mono); border: 1px solid var(--border); border-radius: var(--radius); }
+.diff > span { display: block; padding: 0 .75rem; white-space: pre; }
+.diff-add { background: color-mix(in srgb, #2ea043 18%, transparent); }
+.diff-del { background: color-mix(in srgb, #f85149 18%, transparent); }
